# Copy to .env and fill in. `pnpm dev:feedreel` loads it via dotenv-cli.
# Every key is optional at boot — the app renders an OFF AIR screen listing
# whatever is missing instead of crashing. All keys are needed for the full
# channel: login → popular-post selection → video generation → shared archive.

# X (Twitter) OAuth 2.0 app — https://developer.x.com/en/portal/dashboard
# Create a project + app, enable "User authentication settings":
#   Type of app:  Web App (confidential client)
#   Callback URI: http://localhost:3005/api/auth/callback/twitter
#   Scopes used:  tweet.read users.read offline.access
# Home timeline reads (`/2/users/:id/timelines/reverse_chronological`) need a
# paid API tier; on the free tier the app falls back to your own posts.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# The X handle whose feed powers the default public channel (CH 01). New
# clips are minted only while this account is logged in and watching;
# everyone else replays the archive.
OWNER_X_USERNAME=""

# better-auth signing secret (sign-in with X). Sessions and the X tokens
# live in the Turso database, so sign-in also needs TURSO_DATABASE_URL.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# fal.ai — https://fal.ai/dashboard/keys
# Videos are billed per generation; the default model is fast (~3s for a
# 5s clip) but not free via the API. Generation is lazy (viewer-driven,
# popular posts only, never the same post twice) and capped per day.
FAL_KEY=""

# Clip archive: feedreel's OWN Turso database (do not reuse policingice's).
# Create one with `turso db create feedreel`, then push the schema once:
#   pnpm -F @repo/feedreel db:push
# Unlike policingice, db:push here is safe — this database belongs to this
# app alone. Without these keys the archive only lives in server memory —
# fine for local dev, but anonymous visitors of a deployed site would have
# nothing to replay.
TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
TURSO_AUTH_TOKEN=""

# Optional. Override the text-to-video model (queue endpoint id on fal).
# Non-default models receive only { prompt } — tune src/lib/fal.ts if the
# model needs more input fields.
FAL_VIDEO_MODEL="minimax/h3-max/text-to-video"

# Optional. Public origin used for the OAuth redirect URI when deployed
# behind a proxy; defaults to the request origin (fine for localhost).
APP_URL=""
