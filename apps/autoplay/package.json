{
  "name": "@repo/autoplay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "invite": "pnpm with-env tsx scripts/create-invite.ts",
    "dev": "pnpm with-env next dev --turbopack -p 3005",
    "lint": "oxlint --report-unused-disable-directives",
    "start": "pnpm with-env next start",
    "test": "TURSO_DATABASE_URL=libsql://never-connected.invalid BETTER_AUTH_SECRET=test-secret X_CLIENT_ID=test X_CLIENT_SECRET=test tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fal-ai/client": "1.11.0-alpha.2",
    "@fal-ai/server-proxy": "1.3.0-alpha.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@kyh/tsconfig": "workspace:^",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
