# Google Maps Platform key with the Map Tiles API enabled: the render step reads
# Photorealistic 3D Tiles with it.
GOOGLE_MAPS_API_KEY=

# OpenAI key for the paint step (images/edits).
OPENAI_API_KEY=
# The image model that paints: anything images/edits takes with a mask.
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: a picture of the look to match, sent with every frame.
STYLE_REFERENCE=

# Optional: Chrome or Chromium for the render step (else the installed Chrome).
CHROME_PATH=

# Where the viewer reads the pyramid from; /data (public/data) when unset.
VITE_TILES_URL=
