# Nothing here is needed to render the map: the render step reads only open, keyless data
# (OpenFreeMap, AWS Terrain Tiles, DataSF).

# Optional: Chrome or Chromium for the render step (else the installed Chrome).
CHROME_PATH=

# Optional, for the paint step only: an OpenAI key (images/edits) to repaint the renders.
OPENAI_API_KEY=
# The image model that paints: anything images/edits takes with a mask.
OPENAI_IMAGE_MODEL=gpt-image-1
# A picture of the look to match, sent with every frame.
STYLE_REFERENCE=

# Where the viewer reads the pyramid from; /data (public/data) when unset.
VITE_TILES_URL=
