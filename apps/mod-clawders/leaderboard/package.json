{
  "name": "@repo/mod-clawders-leaderboard",
  "version": "0.1.0",
  "private": true,
  "description": "Keep Clawd running",
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:push-remote": "dotenv -e .env.production.local -- sh -c 'drizzle-kit push --explain && printf \"Apply to the REMOTE database? [y/N] \" && read ok && [ \"$ok\" = y ] && drizzle-kit push'",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "dev": "pnpm with-env next dev --turbopack -p 3016",
    "lint": "oxlint --report-unused-disable-directives",
    "start": "pnpm with-env next start",
    "test": "tsx --test \"test/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@repo/mod-clawders": "workspace:^",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kyh/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.186.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
