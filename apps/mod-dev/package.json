{
  "name": "@repo/mod-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code mod: /score grades a session's work on confidence, idiomatic, simplicity, scope and risk",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "session": "claude --plugin-dir .",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "tsx --test \"test/*.spec.ts\"",
    "test:mod": "claude plugin test .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
    "validate": "claude plugin validate ."
  },
  "devDependencies": {
    "@kyh/tsconfig": "workspace:^",
    "@repo/claude-code-types": "workspace:^",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
