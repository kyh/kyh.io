{
  "name": "@repo/subway-narrator",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code mod: a Subway Surfers-style runner pane narrating Claude's replies with OpenAI text-to-speech",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "dev": "claude --plugin-dir .",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
    "validate": "claude plugin validate ."
  },
  "devDependencies": {
    "@kyh/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
