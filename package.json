{
  "name": "kyh-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:cli": "pnpm -F kyh dev",
    "dev:stonksville": "pnpm -F @repo/stonksville dev",
    "dev:covid": "pnpm -F @repo/covid-19-dashboard dev",
    "dev:autoplay": "pnpm -F @repo/autoplay dev",
    "dev:kwadrants": "pnpm -F @repo/kwadrants dev",
    "dev:policingice": "pnpm -F @repo/policingice dev",
    "dev:kyh": "pnpm -F @repo/kyh dev",
    "dev:party": "pnpm -F @repo/party dev",
    "dev:tc": "pnpm -F @repo/tc dev",
    "dev:vis-ml": "pnpm -F @repo/vis-ml dev",
    "deploy:party": "pnpm -F @repo/party deploy",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 54",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test",
    "verify:ci": "pnpm verify && turbo run build --filter=@repo/party..."
  },
  "devDependencies": {
    "@kyh/oxlint": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
