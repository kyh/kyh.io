{
  "name": "kyh-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:cli": "pnpm -F kyh dev",
    "dev:stonksville": "pnpm -F @repo/stonksville dev",
    "dev:covid": "pnpm -F @repo/covid-19-dashboard dev",
    "dev:autoplay": "pnpm -F @repo/autoplay dev",
    "dev:bay": "pnpm -F @repo/bay dev",
    "dev:kwadrants": "pnpm -F @repo/kwadrants dev",
    "dev:policingice": "pnpm -F @repo/policingice dev",
    "dev:kyh": "pnpm -F @repo/kyh dev",
    "dev:mod-dev": "pnpm -F @repo/mod-dev session",
    "dev:commuting-clawders-mod": "pnpm -F @repo/commuting-clawders-mod session",
    "dev:commuting-clawders": "pnpm -F @repo/commuting-clawders dev",
    "dev:tc": "pnpm -F @repo/tc dev",
    "dev:vis-ml": "pnpm -F @repo/vis-ml dev",
    "lint": "oxlint --report-unused-disable-directives",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "catalog:",
    "ultracite": "8.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
