{
  "name": "@repo/tailwind-compat",
  "version": "0.0.0",
  "private": true,
  "description": "Frozen Tailwind v4.3.3 scale and reset for apps migrated to StyleX",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.stylex": {
      "types": "./tokens.stylex.d.ts",
      "default": "./tokens.stylex.js"
    },
    "./preflight.css": "./preflight.css",
    "./forms.css": "./forms.css",
    "./media.stylex": {
      "default": "./media.stylex.js"
    }
  },
  "peerDependencies": {
    "@stylexjs/stylex": "*"
  }
}
