{
  "name": "@kyh/skills",
  "version": "0.2.1",
  "description": "Personal Claude Code + Codex skills, MCP servers, and global instructions. `npx @kyh/skills install` copies them into a canonical ~/.agents store (and ~/.claude).",
  "license": "MIT",
  "bin": {
    "kyh-skills": "scripts/cli.mjs"
  },
  "files": [
    "scripts",
    "skills",
    "CLAUDE.md",
    "mcp.json",
    "external-skills.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "install:local": "node scripts/cli.mjs install",
    "check:external": "node scripts/cli.mjs check"
  },
  "dependencies": {
    "skills": "^1.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
