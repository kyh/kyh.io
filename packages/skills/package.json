{
  "name": "@kyh/skills",
  "version": "0.2.3",
  "description": "Personal Claude Code + Codex skills, MCP servers, and global instructions. `npx @kyh/skills install` copies them into a canonical ~/.agents store (and ~/.claude).",
  "license": "MIT",
  "bin": {
    "kyh-skills": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "CLAUDE.md",
    "mcp.json",
    "external-skills.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "install:local": "node src/cli.ts install",
    "check:external": "node src/cli.ts check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "skills": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kyh/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
